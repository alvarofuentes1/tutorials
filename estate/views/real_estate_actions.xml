<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_real_estate" model="ir.actions.act_window">
        <field name="name">Lista de Propiedades</field>
        <field name="res_model">real_estate</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>

    <record id="action_property_type" model="ir.actions.act_window">
        <field name="name">Tipos de Propiedad</field>
        <field name="res_model">real_estate_type</field>
    </record>

    <record id="action_property_tag" model="ir.actions.act_window">
        <field name="name">Etiqutas de propiedad</field>
        <field name="res_model">real_estate_tag</field>
    </record>

    <record id="action_view_offers" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">real_estate_offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("property_type_id", "=", active_id)]</field>
    </record>

    <record id="real_estate_action_kanban" model="ir.actions.act_window">
        <field name="name">Propiedades en Kanban</field>
        <field name="res_model">real_estate</field>
        <field name="view_mode">kanban,form</field>
    </record>

</odoo>